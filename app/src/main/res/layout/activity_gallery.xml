<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121316"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_chevron_left"
            android:background="@drawable/bg_pill_button"
            android:backgroundTint="@color/btn_secondary_bg"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGalleryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Security Media Vault"
                android:textColor="#E8EAED"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGallerySub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Silent screenshots &amp; intruder captures"
                android:textColor="@color/btn_secondary_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_button"
            android:backgroundTint="#1E3A2F"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="0 ITEMS"
            android:textColor="#81C995"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Filter Buttons (Screenshots / Intruder Photos) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/tabScreenshots"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_pill_button"
            android:backgroundTint="@color/btn_primary_bg"
            android:text="Screenshots"
            android:textColor="@color/btn_primary_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabIntruders"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_pill_button"
            android:backgroundTint="@color/btn_secondary_bg"
            android:text="Intruder Photos"
            android:textColor="@color/btn_secondary_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No media captured in this vault yet."
        android:textColor="@color/btn_secondary_text"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingTop="64dp"
        android:visibility="gone" />

    <!-- 3-Column Grid RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMediaGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
