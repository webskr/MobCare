<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121316"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="36dp">

        <!-- Top Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keyboard &amp; Telemetry"
                    android:textColor="#F1F3F4"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gboard core ? Keystroke auditing"
                    android:textColor="#9AA0A6"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvKeyboardBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="DEFAULT"
                android:textColor="@color/btn_highlight_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Section 1: Keyboard Controls & Test Pad -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1F24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvKeyboardState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking keyboard status..."
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <Button
                        android:id="@+id/btnEnableKeyboard"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Settings"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/btn_secondary_bg"
                        android:textColor="@color/btn_secondary_text"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnSelectKeyboard"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Switch IME"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/btn_secondary_bg"
                        android:textColor="@color/btn_secondary_text"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnToggleTestPad"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Test Pad"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/btn_secondary_bg"
                        android:textColor="#8AB4F8"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llTestPadContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/etTestInput"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:hint="Tap here to test keyboard..."
                        android:textColorHint="#5F6368"
                        android:textColor="#E8EAED"
                        android:background="@drawable/bg_pill_button"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section 2: Keystroke & Telemetry Logs Feed -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1F24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Keystroke Logs"
                        android:textColor="#F1F3F4"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <Button
                        android:id="@+id/btnRefreshLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Refresh"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/btn_secondary_bg"
                        android:textColor="@color/btn_secondary_text"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnClearLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Clear"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/btn_secondary_bg"
                        android:textColor="@color/btn_destructive_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLogCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 events recorded"
                    android:textColor="#9AA0A6"
                    android:textSize="12sp"
                    android:layout_marginBottom="14dp" />

                <!-- Dynamic container for App-Icon Log Items -->
                <LinearLayout
                    android:id="@+id/logsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>