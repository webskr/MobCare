<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121316"
    android:orientation="vertical">

    <!-- Top Action Bar (No back arrow) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Call &amp; SMS Vault"
                android:textColor="#F1F3F4"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvVaultSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Anti-deletion persistent telecommunications ledger"
                android:textColor="@color/btn_secondary_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVaultBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_button"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="ARMED"
            android:textColor="#81C995"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Permission Banner if not granted -->
    <LinearLayout
        android:id="@+id/bannerCallPermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_button"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Call Log &amp; SMS permissions required."
            android:textColor="#FDD663"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnGrantPermissions"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_button"
            android:backgroundTint="@color/btn_primary_bg"
            android:text="Grant Access"
            android:textColor="@color/btn_primary_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tabs & Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_button"
            android:backgroundTint="@color/btn_primary_bg"
            android:text="All"
            android:textColor="@color/btn_primary_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFilterCalls"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_button"
            android:backgroundTint="@color/btn_secondary_bg"
            android:text="Calls"
            android:textColor="@color/btn_secondary_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnFilterSms"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_button"
            android:backgroundTint="@color/btn_secondary_bg"
            android:text="Messages"
            android:textColor="@color/btn_secondary_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Search Input -->
    <EditText
        android:id="@+id/etVaultSearch"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_button"
        android:hint="Search numbers, contacts, or message text..."
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#E8EAED"
        android:textColorHint="#5F6368"
        android:textSize="13sp"
        android:inputType="text"
        android:maxLines="1" />

    <!-- List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/llVaultListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp" />
    </ScrollView>

</LinearLayout>