<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0B0E"
    android:fitsSystemWindows="true">

    <!-- Top Status / Role Banner (Shown only when MobCare is NOT default launcher) -->
    <LinearLayout
        android:id="@+id/bannerSetDefault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E2830"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Set MobCare as Default Home Screen"
            android:textColor="#8AB4F8"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/btnSetDefaultHome"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Set Default"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:backgroundTint="#4CAF50"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <!-- Header Bar with Search & Quick Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_icon"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#7A7F8E"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/etSearchApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Search apps..."
                android:textColorHint="#5F6368"
                android:textColor="#ECEEF4"
                android:textSize="13sp"
                android:singleLine="true"
                android:imeOptions="actionDone" />
        </LinearLayout>

        <!-- Identity Swap / Disguise Action Button -->
        <ImageView
            android:id="@+id/btnOpenIdentitySwap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:padding="9dp"
            android:background="@drawable/bg_stat_icon"
            android:src="@drawable/ic_feature_keyboard"
            app:tint="#8AB4F8"
            android:contentDescription="Identity Swap" />

        <!-- Security Hub Direct Access (Protected by PIN or Tap) -->
        <ImageView
            android:id="@+id/btnOpenHub"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:padding="9dp"
            android:background="@drawable/bg_stat_icon"
            android:src="@drawable/ic_section_core"
            app:tint="#4CAF50"
            android:contentDescription="MobCare Security Hub" />
    </LinearLayout>

    <!-- Swapped Disguise Status Pill (Optional indicator if disguised) -->
    <LinearLayout
        android:id="@+id/layoutSwapIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/bg_badge_blue_dark"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSwapStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Identity Swapped"
            android:textColor="#8AB4F8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Apps Grid Loading Progress -->
    <ProgressBar
        android:id="@+id/pbLauncherLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="60dp"
        android:visibility="gone" />

    <!-- Apps Grid (4 columns for optimal launcher aesthetics) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLauncherApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</LinearLayout>
