<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121316"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="36dp">

        <!-- Top Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stealth &amp; Anti-Tamper"
                    android:textColor="#F1F3F4"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device Admin &amp; Decoy Protection"
                    android:textColor="#9AA0A6"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 1: Anti-Uninstall Device Administrator -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1F24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Anti-Uninstall Protection"
                        android:textColor="#F1F3F4"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvAdminBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_button"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="INACTIVE"
                        android:textColor="#FDD663"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uses Android Device Administrator privileges to lock the Uninstall button in phone settings. Prevents intruders from deleting or stopping MobCare."
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnToggleAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Activate Device Administrator"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#26272E"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section 1.5: Display Over Other Apps (Overlay Authority) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1F24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Display Over Other Apps"
                        android:textColor="#F1F3F4"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvOverlayBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_button"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="REQUIRED"
                        android:textColor="#FDD663"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allows MobCare to display the invisible camera snapper on the lock screen and launch the 3-second face sentinel screen immediately upon device unlock."
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnGrantOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Grant Overlay Permission"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#26272E"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section 2: Decoy Crash Gate (Fake Crash Screen) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1F24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Decoy Fake Crash Gate"
                        android:textColor="#F1F3F4"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvFakeCrashBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_button"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="OFF"
                        android:textColor="#9AA0A6"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="When enabled, anyone opening MobCare sees a realistic fake crash alert ('Google Play Services keeps stopping'). Only the owner can bypass it by tapping the title 3 times and entering the master PIN."
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnToggleFakeCrash"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Enable Fake Crash Gate"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#3C4043"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section 3: Master PIN Security -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1F24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Master Security PIN"
                    android:textColor="#F1F3F4"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvPinInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current PIN: Configured (Default: 1337)"
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnChangePin"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Change Master PIN"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#26272E"
                    android:textColor="#8AB4F8" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section 4: System Diagnostics Camouflage Cloak -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1F24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="System Diagnostics Cloak"
                        android:textColor="#F1F3F4"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvCamouflageBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_button"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="OFF"
                        android:textColor="#9AA0A6"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disguises MobCare as a harmless 'System Diagnostics' tool displaying live battery and RAM metrics. An intruder only sees hardware diagnostics. Tap the battery ring 3 times to unlock the true master dashboard."
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnToggleCamouflage"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Enable Diagnostics Cloak"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#3C4043"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section 5: Intruder Photo Snaps (Front Camera Vault) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1F24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Intruder Photo Snaps"
                        android:textColor="#F1F3F4"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvIntruderBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_button"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="0 SNAPS"
                        android:textColor="#8AB4F8"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Silently takes front-facing camera photos when an unauthorized person inputs a wrong PIN or fails the device lock screen. Photos are stored inside MobCare's private vault and never appear in Google Photos or device gallery."
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnGrantCamera"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Grant Camera Permission"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#FDD663"
                    android:textColor="#121316"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnViewIntruders"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Inspect Photos"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="#26272E"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnClearIntruders"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="Clear"
                        android:textSize="13sp"
                        android:backgroundTint="#26272E"
                        android:textColor="#F28B82" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section 6: Post-Unlock Biometric Sentinel -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1F24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Post-Unlock Face Sentinel"
                        android:textColor="#F1F3F4"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvSentinelBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_button"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="OFF"
                        android:textColor="#9AA0A6"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Whenever the device is unlocked, a 3-second biometric verification screen instantly appears. Silently photographs whoever unlocked the device while the dismissal button is locked."
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnToggleSentinel"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Enable Post-Unlock Sentinel"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#3C4043"
                    android:textColor="#FFFFFF" />
                <!-- Section 7: Silent Sentinel Screenshot Engine -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E1F24"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Silent Screenshot Sentinel"
                            android:textColor="#E8EAED"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScreenshotBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_active"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="3dp"
                            android:text="ARMED"
                            android:textColor="#81C995"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="16dp"
                        android:text="Capture display state silently without flash, sound or OS notification using Sentinel engine."
                        android:textColor="#9AA0A6"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnTakeSilentScreenshot"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_pill_button"
                        android:backgroundTint="#8AB4F8"
                        android:text="Take Silent Screenshot Now"
                        android:textColor="#121316"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnViewScreenshots"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_pill_button"
                        android:backgroundTint="#2B2C33"
                        android:text="View Captured Screenshots"
                        android:textColor="#E8EAED"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>