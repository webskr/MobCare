<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121316"
    android:orientation="vertical">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Package Guardian"
                android:textColor="#F1F3F4"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Inventory &amp; Sideload Monitor"
                android:textColor="#9AA0A6"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4 Filter Tabs Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabInstalled"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="User Apps"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#26272E"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/tabSystem"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="System Apps"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#26272E"
                android:textColor="#9AA0A6"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/tabRecent"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Recent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#26272E"
                android:textColor="#9AA0A6"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/tabDeleted"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Deleted Vault"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#26272E"
                android:textColor="#9AA0A6" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- App Count Header -->
    <TextView
        android:id="@+id/tvAppCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading applications..."
        android:textColor="#9AA0A6"
        android:textSize="13sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="10dp" />

    <!-- Scrollable Apps List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/appsListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="36dp" />
    </ScrollView>

</LinearLayout>