<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121316"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <!-- Top Title Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Encrypted Vault &amp; Sync"
                android:textColor="#F1F3F4"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvVaultEngineBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="AES-256 GCM"
                android:textColor="#81C995"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Military-grade cryptographic archive and silent remote dispatcher for device telemetry."
            android:textColor="#9AA0A6"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <!-- Card 1: Vault Overview Stats -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1F24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telemetry Payload Ready"
                    android:textColor="#F1F3F4"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvVaultStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scanning local logs..."
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnExportVault"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Encrypt &amp; Export Archive (.mcsafe)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#26272E"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 2: Telegram Silent Alert Dispatcher -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1F24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Telegram Alert Dispatcher"
                        android:textColor="#F1F3F4"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvTelegramBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_button"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="STANDBY"
                        android:textColor="#FDD663"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automatically sends silent notifications, intruder photos, and telemetry digests to your private Telegram bot."
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="14dp" />

                <EditText
                    android:id="@+id/etTelegramToken"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="Telegram Bot Token"
                    android:textColorHint="#5F6368"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:background="@drawable/bg_pill_button"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="10dp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/etTelegramChatId"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="Chat ID (e.g. 123456789)"
                    android:textColorHint="#5F6368"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:background="@drawable/bg_pill_button"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="16dp"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSaveTelegram"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Save Config"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="#26272E"
                        android:textColor="#8AB4F8" />

                    <Button
                        android:id="@+id/btnTestTelegram"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="Send Test Ping"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="#163A34"
                        android:textColor="#81C995" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 3: Discord & Custom Webhook Dispatcher -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1F24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Discord &amp; Custom Webhook"
                        android:textColor="#F1F3F4"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvWebhookBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_button"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="STANDBY"
                        android:textColor="#FDD663"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Discreetly dispatches security alerts, keystroke summaries, and photos to a private Discord channel or custom HTTP JSON endpoint."
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="14dp" />

                <EditText
                    android:id="@+id/etWebhookUrl"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="Webhook URL (Discord / Slack / Server)"
                    android:textColorHint="#5F6368"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:background="@drawable/bg_pill_button"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="16dp"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSaveWebhook"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Save Webhook"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="#26272E"
                        android:textColor="#8AB4F8" />

                    <Button
                        android:id="@+id/btnTestWebhook"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="Send Webhook Ping"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="#163A34"
                        android:textColor="#81C995" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 3: Anti-Forensic Data Scrub -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1F24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anti-Forensics &amp; Local Scrub"
                    android:textColor="#F1F3F4"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Permanently purges unencrypted plaintext audit logs, notification caches, and clipboard history from internal device flash memory."
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnPurgeLogs"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Scrub Local Logs"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#3D2020"
                    android:textColor="#F28B82" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
