                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Web Intelligence"
                        android:textColor="#F1F3F4"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvBrowserCardSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monitored URLs, search queries &amp; browser activity"
                        android:textColor="#9AA0A6"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBrowserCardBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_button"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="ARMED"
                    android:textColor="#81C995"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp" />
