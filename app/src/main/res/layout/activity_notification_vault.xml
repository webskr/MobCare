<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121316"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alerts &amp; Clipboard Vault"
                android:textColor="#F1F3F4"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification snapshots &amp; copied text history"
                android:textColor="#9AA0A6"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVaultBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="ACTIVE"
            android:textColor="#81C995"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Two Filter Tabs & Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/tabNotifications"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Notifications"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#26272E"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/tabClipboard"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Clipboard"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#26272E"
            android:textColor="#9AA0A6"
            android:layout_marginEnd="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Refresh"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#26272E"
            android:textColor="#8AB4F8"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Clear"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#26272E"
            android:textColor="#F28B82" />
    </LinearLayout>

    <!-- Permission Warning Banner (Hidden if granted) -->
    <LinearLayout
        android:id="@+id/bannerPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2E2010"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notification Access is required to capture incoming messages."
            android:textColor="#FDD663"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnGrantAccess"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Grant"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#FDD663"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- Record Count Subtitle -->
    <TextView
        android:id="@+id/tvCountSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 records in vault"
        android:textColor="#9AA0A6"
        android:textSize="13sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="10dp" />

    <!-- Scrollable Feed -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/itemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="36dp" />
    </ScrollView>

</LinearLayout>